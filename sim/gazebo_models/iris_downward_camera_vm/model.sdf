<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="iris_downward_camera_vm">
    <!--
      VM-only variant of ../iris_downward_camera/model.sdf -- identical in every way
      except update_rate (15Hz, not 30). Resolution/horizontal_fov/clip are UNCHANGED on
      purpose: src/gazebo_source.py's CAMERA_WIDTH/HEIGHT/CAMERA_HORIZONTAL_FOV_RAD build
      the camera_matrix used for solvePnP, and those constants are shared across every
      machine -- changing resolution here would silently break pose accuracy on this
      model without a matching Python-side change, so this only touches render
      FREQUENCY (half the CPU-bound rasterize+mipmap calls per second under this VM's
      software renderer), not anything solvePnP depends on. See ../iris_downward_camera/
      for the full rationale on the rest of this model (fixed non-gimbaled camera, FOV
      matching the senior's real calibration, base_link resolution notes).
    -->
    <include>
      <uri>model://iris_with_ardupilot</uri>
    </include>

    <link name="downward_camera_link">
      <pose>0 0 -0.05 0 1.5708 0</pose>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz>
          <ixy>0.0</ixy><ixz>0.0</ixz><iyz>0.0</iyz>
        </inertia>
      </inertial>
      <sensor name="downward_camera" type="camera">
        <camera>
          <horizontal_fov>1.1490</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <topic>precision_landing/camera/image_raw</topic>
      </sensor>
    </link>

    <joint name="downward_camera_joint" type="fixed">
      <parent>iris_with_ardupilot::iris_with_standoffs::base_link</parent>
      <child>downward_camera_link</child>
    </joint>
  </model>
</sdf>
