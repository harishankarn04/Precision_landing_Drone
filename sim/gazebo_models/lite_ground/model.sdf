<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="lite_ground">
    <!--
      VM-only stand-in for the ardupilot_gazebo plugin's own "runway" model. Physics is
      IDENTICAL -- runway's own collision was always just an infinite flat plane (checked
      by reading its model.sdf directly, 2026-09-24), never a mesh, so this changes zero
      rigid-body behaviour (gravity, mass, collision response all unaffected). What it
      drops is runway's VISUAL: a mesh (airfield.dae) plus four 2K PBR texture maps
      (albedo/normal/roughness/ambient-occlusion) that cost real CPU time to rasterize
      and mipmap under this VM's software renderer (swrast via Xvfb) for zero physics
      benefit. Not used by sim/gazebo_worlds/precision_landing_world.sdf (Mac Mini keeps
      the real runway, real GPU, no reason to give up the visual quality there).
    -->
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
          </plane>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>200 200</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
